            </body>
            <body name="reached_7" pos="0 0 -10" mocap="true">
                <geom type="sphere" size="0.015" rgba="0 0.8 0 0.7" contype="0" conaffinity="0"/>
            </body>
            <body name="reached_8" pos="0 0 -10" mocap="true">
